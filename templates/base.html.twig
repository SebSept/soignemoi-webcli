<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}SoigneMoi WebClient{% endblock %}</title>
    <link rel="icon" href="{{ asset('icon.png') }}">
    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {# import des dépendances js et css gérés par assetMapper
           https://symfony.com/doc/current/frontend/asset_mapper.html#installation #}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>

{# haut de page - header #}
<header class="bg-info-subtle py-3">
    <div class="container-fluid mt-5 mt-md-0">
        <div class="row mb-2">
            <div class="col-10 ">
                <a class="dropdown-item d-flex align-items-center" href="{{ path('app_home') }}">
                    <h1 class="display-5">Hopital SoigneMoi</h1>
                </a>
            </div>
            <div class="col-2 d-flex align-items-center justify-content-end">
                {{ include('_partial/menu_' ~ app.user.role|default('visitor') ~ '.html.twig') }}
            </div>
        </div>
    </div>
</header>

{# Partie principale #}
<main>
    <div class="container-fluid mt-2">

        {# affichage des notifications - messages flashes #}
        {% block flash %}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    {# https://getbootstrap.com/docs/4.0/components/alerts/ #}
                    <div class="alert alert-{{ label }}" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}
        {% endblock %}

        {% block body %}{% endblock %}
    </div>
</main>

{# pied de page - footer #}
<footer class="bg-info-subtle p-3 mt-2">
    <div class="container-fluid">
        <div class="row d-flex flex-row align-items-center">
            {# bloc de liens #}
            <div class="flex-column col-md-6 text-center">
                <p>Copyrights Hopital SoigneMoi</p>
                <p><a href="#">CGV</a></p>
            </div>

            {# bloc de connexion | utilisateur connecté #}
            <div class="flex-column col-md-6 text-center">
                {% if app.user %}
                    <p>
                        {{ app.user.userIdentifier }}<br>
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    </p>
                {% else %}
                    <p>
                        <a href="{{ path('app_login') }}">Connexion</a>
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
</footer>
</body>
</html>
